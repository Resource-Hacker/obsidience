{
  "compilerOptions": {
    "composite": true, "module": "ESNext", "moduleResolution": "bundler",
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": false, "skipLibCheck": true, "noEmit": true,
    "paths": { "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/main/config/schema.ts"]
}
