+    async def _transcribe(self, audio: bytes):
+        # ASR mutates streaming caches. Keep inference off the playback loop,
+        # but drain native work before cancellation releases the shared state.
+        async with self._model_lock:
+            inference = asyncio.create_task(asyncio.to_thread(self._model.transcribe, audio))
+            try:
+                return await asyncio.shield(inference)
+            except asyncio.CancelledError:
+                while not inference.done():
+                    try:
+                        await asyncio.shield(inference)
+                    except asyncio.CancelledError:
+                        continue
+                    except Exception:
+                        break
+                if not inference.cancelled():
+                    inference.exception()  # Retrieve an error without replacing cancellation.
+                raise
+
