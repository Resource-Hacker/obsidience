[Unit]
Description=Squanchbot graph local virtual camera
After=obsidience-harness-dev.service
Wants=obsidience-harness-dev.service
ConditionPathExists=/dev/video42

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=60s
WorkingDirectory=%h/Projects/obsidience
ExecStartPre=/usr/bin/v4l2-ctl --device=/dev/video42 --set-ctrl=timeout=1000
ExecStart=/usr/bin/python %h/Projects/obsidience/obsidience/discord/camera/graph-camera.py --size 1280x720
UMask=0077
Environment=CUDA_VISIBLE_DEVICES=
UnsetEnvironment=DISPLAY WAYLAND_DISPLAY CREDENTIALS_DIRECTORY
# Expose only the verified AMD iGPU; never either NVIDIA GPU.
TemporaryFileSystem=/dev/dri:ro
# Installation drop-in supplies exact AMD BindPaths and GPU identity variables.
InaccessiblePaths=-/dev/nvidia0 -/dev/nvidia1 -/dev/nvidia2 -/dev/nvidiactl -/dev/nvidia-modeset -/dev/nvidia-uvm -/dev/nvidia-uvm-tools
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t /dev/video42
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
KillMode=control-group
TimeoutStopSec=10s
Restart=no
CPUWeight=25
MemoryMax=2G
TasksMax=192
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
