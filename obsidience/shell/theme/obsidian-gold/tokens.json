  "type": {
    "body_family": "sans-serif",
    "technical_family": "JetBrains Mono, monospace",
    "body_px": 14,
    "small_px": 12,
    "pane_title_px": 14,
    "section_px": 18,
    "display_px": 32,
    "body_line_height": 1.5,
