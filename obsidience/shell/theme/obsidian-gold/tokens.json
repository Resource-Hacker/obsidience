    "hover_ms": 100,
    "navigation_ms": 120,
    "idle_animation": false,
    "scanline_flicker": false,
    "shader_effects": false,
    "existing_oled_policy": "Keep existing compositor owner; never add a theme timer."
  },
  "accessibility": {
    "body_contrast_minimum": 4.5,
    "ui_contrast_minimum": 3,
    "focus_ring_px": 2,
    "status_requires_text": true,
