#!/usr/bin/env bash
set -euo pipefail

if (( EUID != 0 )); then
    printf '%s\n' 'install-session must run as root' >&2
    exit 77
fi

session_dir=/usr/local/share/wayland-sessions
session_target="$session_dir/obsidience.desktop"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
session_source="$script_dir/obsidience.desktop"

if [[ -L "$session_target" ]]; then
    [[ "$(readlink -f -- "$session_target")" == "$session_source" ]] || {
        printf 'refusing to replace unrelated session link: %s\n' "$session_target" >&2
        exit 1
    }
    unlink -- "$session_target"
elif [[ -e "$session_target" && ! -f "$session_target" ]]; then
    printf 'refusing to replace non-file session entry: %s\n' "$session_target" >&2
    exit 1
fi

install -d -o root -g root -m 0755 "$session_dir"
install -o root -g root -m 0644 "$session_source" "$session_target"
desktop-file-validate "$session_target"
