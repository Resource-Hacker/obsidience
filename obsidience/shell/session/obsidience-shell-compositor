#!/usr/bin/env bash
set -euo pipefail

drm_card="$(readlink -f /dev/dri/by-path/pci-0000:01:00.0-card)"
[[ "$drm_card" == /dev/dri/card[0-9]* && -c "$drm_card" ]] || exit 1

export KWIN_DRM_DEVICES="$drm_card"
export KWIN_DRM_NO_DIRECT_SCANOUT=1
export QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1

exec /usr/bin/kwin_wayland \
    --xwayland \
    --no-kactivities \
    --exit-with-session /home/wissenschafter/Projects/obsidience/obsidience/shell/session/obsidience-shell-session
