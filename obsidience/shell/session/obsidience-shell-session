#!/usr/bin/env bash
set -euo pipefail

guard_pid=""

cleanup() {
    trap - EXIT HUP INT TERM
    systemctl --user stop obsidience-shell-session.target 2>/dev/null || true
    if [[ -n "$guard_pid" ]]; then
        kill "$guard_pid" 2>/dev/null || true
    fi
}

trap cleanup EXIT
trap 'exit 0' HUP INT TERM

/usr/bin/uwsm finalize XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
systemctl --user start obsidience-shell-session.target
/usr/bin/sleep infinity &
guard_pid=$!
wait "$guard_pid"
