[Unit]
Description=Obsidience Three.js knowledge desktop
Requires=obsidience-shell-host.service obsidience-harness-dev.service
After=obsidience-shell-host.service obsidience-harness-dev.service
PartOf=obsidience-shell-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/wissenschafter/Projects/obsidience
Environment=GDK_BACKEND=wayland
Environment=WEBKIT_DMABUF_RENDERER_FORCE_SHM=1
Environment=OBSIDIENCE_KNOWLEDGE_ORIGIN=http://127.0.0.1:8765/shell/knowledge/
Environment=OBSIDIENCE_SURFACE_LAYOUT=%h/.config/obsidience-shell/surface-layout.json
ExecStartPre=/usr/bin/curl --fail --silent --show-error --output /dev/null --retry 30 --retry-delay 1 --retry-connrefused http://127.0.0.1:8765/shell/knowledge/
ExecStart=/usr/bin/python3 /home/wissenschafter/Projects/obsidience/obsidience/shell/surfaces/knowledge/host.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
UMask=0077
CPUWeight=25
