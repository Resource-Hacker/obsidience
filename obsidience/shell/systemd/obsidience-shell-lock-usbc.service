[Unit]
Description=Obsidience USB-C graph desktop and lock cover
Requires=usb-monitor-xorg.service
Wants=obsidience-harness-dev.service
After=usb-monitor-xorg.service obsidience-harness-dev.service
PartOf=usb-monitor-xorg.service graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
Slice=app.slice
WorkingDirectory=/home/wissenschafter/Projects/obsidience-hyprland
Environment=DISPLAY=:2.0
Environment=WAYLAND_DISPLAY=
Environment=GDK_BACKEND=x11
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=OBSIDIENCE_LOCK_STATE=/run/user/1000/obsidience-shell/lock-state
Environment=OBSIDIENCE_SURFACE_ID=usb-c
Environment=OBSIDIENCE_SURFACE_LAYOUT=/home/wissenschafter/.config/obsidience-shell/surface-layout.json
Environment=OBSIDIENCE_KNOWLEDGE_URL=http://127.0.0.1:8765/shell/knowledge/?surface=knowledge&surface_id=usb-c
UnsetEnvironment=SESSION_MANAGER
ExecStartPre=/usr/bin/bash -c 'for i in {1..80}; do DISPLAY=:2.0 /usr/bin/xdpyinfo >/dev/null 2>&1 && exit 0; /usr/bin/sleep 0.25; done; exit 1'
ExecStartPre=/usr/bin/install -d -m 0700 %t/obsidience-shell
ExecStartPre=/usr/bin/install -d -m 0700 %h/.config/obsidience-shell
ExecStartPre=/usr/bin/cp --no-clobber /home/wissenschafter/Projects/obsidience-hyprland/obsidience/shell/state/initial-surface-layout.json %h/.config/obsidience-shell/surface-layout.json
ExecStart=/usr/bin/python3 /home/wissenschafter/Projects/obsidience-hyprland/obsidience/shell/surfaces/lock/host.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
UMask=0077
CPUWeight=25

[Install]
WantedBy=usb-monitor-xorg.service
