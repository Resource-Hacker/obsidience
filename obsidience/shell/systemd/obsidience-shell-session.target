[Unit]
Description=Obsidience desktop shell session
# Wants, not Requires: Requires= would propagate a host restart to this
# target and from it to every PartOf member, including the graph presenter.
Wants=obsidience-shell-host.service
After=wayland-session@Hyprland.target
BindsTo=wayland-session@Hyprland.target
PartOf=wayland-session@Hyprland.target
Wants=obsidience-harness-dev.service
Wants=obsidience-shell-knowledge.service
Wants=obsidience-shell-agent-canvas.service
Wants=obsidience-shell-notifications.service
Wants=obsidience-shell-window-adapter.service
Wants=obsidience-shell-screen-replay@samsung.service
Wants=obsidience-shell-screen-replay@dp-4.service
Wants=obsidience-shell-screen-replay@usb-c.service
