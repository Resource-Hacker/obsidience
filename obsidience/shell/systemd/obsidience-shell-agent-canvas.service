[Unit]
Description=Obsidience agent canvas (nodeterm Server Edition)
# Optional provider for the Terminal pane's AGENT CANVAS tab. nodeterm owns
# its canvas, auth and tmux server (`tmux -L node-terminal`); the Shell only
# presents the loopback page. The pane degrades to a reconnect control.
After=obsidience-shell-host.service
PartOf=obsidience-shell-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/obsidience-agent-canvas/current
Environment=NODETERM_HOST=127.0.0.1
Environment=NODETERM_PORT=8770
Environment=NODETERM_DATA_DIR=%h/.local/state/obsidience-agent-canvas
ExecStart=/usr/bin/node out/server/main.cjs
Restart=on-failure
RestartSec=2
# Upstream continuity contract: stopping the canvas stops only its Node
# process. The tmux server holding live agent sessions survives restarts.
KillMode=process
TimeoutStopSec=5
UMask=0077
CPUWeight=25
