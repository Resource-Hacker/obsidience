[Unit]
Description=Obsidience rolling screen replay buffer for the %i Surface
# One gpu-screen-recorder per Shell Surface keeps the last minute in RAM; the
# Executive's computer.replay writes it to a clip with SIGUSR1 (recording
# continues), reads it and deletes it. A keyframe every 0.5 s lets the reader
# decode keyframes only. The WoW lease stops and restores it.
PartOf=obsidience-shell-session.target
After=wayland-session@Hyprland.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=/home/wissenschafter/Projects/obsidience
Environment=PYTHONPATH=/home/wissenschafter/Projects/obsidience
# The static build's FFmpeg negotiates the NVENC API version at runtime, so the
# Samsung encodes on the RTX 4080 under any driver the host carries.
ExecStartPre=/usr/bin/rm -rf %t/obsidience-screen-replay/%i
ExecStartPre=/usr/bin/mkdir -p -m 0700 %t/obsidience-screen-replay/%i
# The instance is a Surface id; its connector is resolved at each start, since
# connector names change when GPUs are added or removed.
ExecStart=/usr/bin/sh -c 'output=$$(/usr/bin/python -m obsidience.shell.surface_identity %i) && exec /var/lib/ai/opt/gpu-screen-recorder-6.1.2-static/bin/gpu-screen-recorder -w "$$output" -c mkv -k hevc -f 30 -keyint 0.5 -r 60 -replay-storage ram -cursor yes -o %t/obsidience-screen-replay/%i'
ExecStopPost=/usr/bin/rm -rf %t/obsidience-screen-replay/%i
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=10
UMask=0077
CPUWeight=25
