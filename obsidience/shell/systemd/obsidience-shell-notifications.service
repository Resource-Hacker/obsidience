[Unit]
Description=Wayland notifications for the Obsidience shell session
After=main-compositor-ready.target
PartOf=obsidience-shell-session.target graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=/usr/bin/mako
Restart=on-failure
RestartSec=2
CPUWeight=25
IOWeight=25
