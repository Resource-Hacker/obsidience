[Unit]
Description=Obsidience Surface input D-Bus adapter
After=usb-monitor-xorg.service
PartOf=main-compositor-ready.target

[Service]
Type=simple
WorkingDirectory=/home/wissenschafter/Projects/obsidience-hyprland
ExecStart=/usr/bin/python /home/wissenschafter/Projects/obsidience-hyprland/obsidience/shell/input/dbus_bridge.py
ExecStartPost=/usr/bin/systemctl --user --no-block start dp4-edge-bridge.service
ExecStopPost=/usr/bin/systemctl --user --no-block stop dp4-edge-bridge.service
Restart=always
RestartSec=1

[Install]
WantedBy=main-compositor-ready.target
