[Unit]
Description=Obsidience Surface input D-Bus adapter
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/wissenschafter/Projects/obsidience
ExecStart=/usr/bin/python /home/wissenschafter/Projects/obsidience/obsidience/shell/input/dbus_bridge.py
ExecStartPost=/usr/bin/systemctl --user --no-block start dp4-edge-bridge.service
ExecStopPost=/usr/bin/systemctl --user --no-block stop dp4-edge-bridge.service
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
