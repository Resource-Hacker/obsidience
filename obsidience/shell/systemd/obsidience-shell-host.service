[Unit]
Description=Native Obsidience Wayland shell host
Requires=main-compositor-ready.target
After=main-compositor-ready.target
PartOf=obsidience-shell-session.target graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/wissenschafter/Projects/obsidience
Environment=QT_QPA_PLATFORM=wayland
Environment=QS_NO_RELOAD_POPUP=1
ExecStartPre=/usr/bin/install -d -m 0700 %t/obsidience-shell
ExecStartPre=/usr/bin/cp --no-clobber /home/wissenschafter/Projects/obsidience/obsidience/shell/state/initial-pane-placement.json %t/obsidience-shell/pane-placement.json
ExecStart=/usr/bin/quickshell --no-duplicate --path /home/wissenschafter/Projects/obsidience/obsidience/shell/qml
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
UMask=0077
CPUWeight=25
