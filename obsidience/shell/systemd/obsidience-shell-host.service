[Unit]
Description=Native Obsidience shell host
After=obsidience-harness-dev.service
PartOf=obsidience-shell-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/wissenschafter/Projects/obsidience
Environment=QT_QPA_PLATFORM=wayland
Environment=QS_NO_RELOAD_POPUP=1
Environment=OBSIDIENCE_THEME_PATH=/home/wissenschafter/Projects/obsidience/obsidience/shell/theme/palette.json
ExecStartPre=/usr/bin/install -d -m 0700 %t/obsidience-shell
ExecStartPre=/usr/bin/install -d -m 0700 %h/.config/obsidience-shell
ExecStartPre=/usr/bin/cp --no-clobber /home/wissenschafter/Projects/obsidience/obsidience/shell/state/initial-pane-placement.json %t/obsidience-shell/pane-placement.json
ExecStartPre=/usr/bin/cp --no-clobber /home/wissenschafter/Projects/obsidience/obsidience/shell/state/initial-reader-placement.json %t/obsidience-shell/reader-placement.json
ExecStartPre=/usr/bin/cp --no-clobber /home/wissenschafter/Projects/obsidience/obsidience/shell/state/initial-terminal-placement.json %t/obsidience-shell/terminal-placement.json
ExecStartPre=/usr/bin/cp --no-clobber /home/wissenschafter/Projects/obsidience/obsidience/shell/state/initial-unlocked-state %t/obsidience-shell/lock-state
ExecStartPre=/usr/bin/cp --no-clobber /home/wissenschafter/Projects/obsidience/obsidience/shell/state/initial-fullscreen-state %t/obsidience-shell-fullscreen.state
ExecStartPre=/usr/bin/cp --no-clobber /home/wissenschafter/Projects/obsidience/obsidience/shell/state/initial-surface-layout.json %h/.config/obsidience-shell/surface-layout.json
ExecStart=/usr/bin/quickshell --no-duplicate --path /home/wissenschafter/Projects/obsidience/obsidience/shell/qml
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
UMask=0077
CPUWeight=25
