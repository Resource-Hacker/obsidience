[Unit]
Description=Single-owner input router for isolated Obsidience Surfaces
BindsTo=dp4-edge-dbus.service
Requires=usb-monitor-xorg.service
After=dp4-edge-dbus.service usb-monitor-xorg.service
PartOf=dp4-edge-dbus.service

[Service]
Type=simple
WorkingDirectory=/home/wissenschafter/Projects/obsidience-hyprland
Environment=DP4_USER_UID=1000
Environment=DP4_USER_GID=1000
Environment=DP4_RUNTIME_DIR=/run/user/1000
Environment=PYTHONPATH=/home/wissenschafter/Projects/obsidience-hyprland
Environment=OBSIDIENCE_SURFACE_LAYOUT=/home/wissenschafter/.config/obsidience-shell/surface-layout.json
Environment="ADMECH_POINTER_MATCH=Logitech G502 X PLUS"
Environment=ADMECH_DP4_MOUSE_SCALE=0.03125
Environment=ADMECH_USB_MOUSE_SCALE=0.0625
EnvironmentFile=-/home/wissenschafter/.config/admech-mouse-profile/active.env
ExecStartPre=/usr/bin/install -d -m 0700 /home/wissenschafter/.config/obsidience-shell
ExecStartPre=/usr/bin/cp --no-clobber /home/wissenschafter/Projects/obsidience-hyprland/obsidience/shell/state/initial-surface-layout.json /home/wissenschafter/.config/obsidience-shell/surface-layout.json
ExecStartPre=/usr/bin/bash -lc '/usr/bin/sudo -n /usr/bin/pkill -TERM -f "python3 .*[/]home/wissenschafter/bin/(dp4-edge-bridge|usb-monitor-edge-bridge)" 2>/dev/null || true'
ExecStart=/usr/bin/sudo -n /usr/bin/env DP4_USER_UID=1000 DP4_USER_GID=1000 DP4_RUNTIME_DIR=/run/user/1000 PYTHONPATH=/home/wissenschafter/Projects/obsidience-hyprland OBSIDIENCE_SURFACE_LAYOUT=/home/wissenschafter/.config/obsidience-shell/surface-layout.json "DP4_POINTER_MATCH=${ADMECH_POINTER_MATCH}" "ADMECH_DP4_MOUSE_SCALE=${ADMECH_DP4_MOUSE_SCALE}" "ADMECH_USB_MOUSE_SCALE=${ADMECH_USB_MOUSE_SCALE}" /usr/bin/python -m obsidience.shell.input.router
Restart=always
RestartSec=1
TimeoutStopSec=2

[Install]
WantedBy=main-compositor-ready.target
