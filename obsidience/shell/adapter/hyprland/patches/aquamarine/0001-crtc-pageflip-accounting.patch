             assigned = true;
             changed.emplace_back(c);
             std::erase(recheck, c);
@@ -842,7 +842,7 @@ void Aquamarine::CDRMBackend::recheckCRTCs() {
                 continue;
 
             backend->log(AQ_LOG_DEBUG, std::format("drm: backup slot {} crtc {} assigned to disabled {}", i, crtcs.at(i)->id, c->szName));
-            c->crtc = crtcs.at(i);
