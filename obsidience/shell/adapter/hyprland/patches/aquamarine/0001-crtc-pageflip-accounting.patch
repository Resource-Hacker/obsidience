diff --git a/src/backend/drm/DRM.cpp b/src/backend/drm/DRM.cpp
index 888fef21..ccc2cc56 100644
--- a/src/backend/drm/DRM.cpp
+++ b/src/backend/drm/DRM.cpp
@@ -410,7 +410,7 @@ void Aquamarine::CDRMBackend::restoreAfterVT() {
