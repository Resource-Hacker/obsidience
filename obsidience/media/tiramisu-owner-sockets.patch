diff --git a/internal/localapi/localapi.go b/internal/localapi/localapi.go
new file mode 100644
index 0000000..3e8fb87
--- /dev/null
+++ b/internal/localapi/localapi.go
@@ -0,0 +1,53 @@
+// Obsidience installation transport: HTTP semantics over owner-only Unix sockets.
+package localapi
+
+import (
+	"context"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"time"
+)
+
+var Draining atomic.Bool
+var Mounted atomic.Bool
+
+func Enabled() bool { return os.Getenv("TIRAMISU_SOCKET_DIR") != "" }
+func Listen(name string) (net.Listener, error) {
+	path := filepath.Join(os.Getenv("TIRAMISU_SOCKET_DIR"), name+".sock")
+	// Never unlink another live or stale listener. systemd owns the private runtime directory.
+	listener, err := net.Listen("unix", path)
+	if err == nil {
+		err = os.Chmod(path, 0600)
+		if err != nil {
+			listener.Close()
+		}
+	}
+	return listener, err
+}
+func Dial(ctx context.Context, network, address string) (net.Conn, error) {
+	if Enabled() && address == "127.0.0.1:8090" {
+		network, address = "unix", filepath.Join(os.Getenv("TIRAMISU_SOCKET_DIR"), "engine.sock")
+	}
+	return (&net.Dialer{Timeout: 10 * time.Second, KeepAlive: 30 * time.Second}).DialContext(ctx, network, address)
+}
+func Control(w http.ResponseWriter, r *http.Request) {
+	if Draining.Load() {
+		http.Error(w, "provider draining", 503)
+		return
+	}
+	// No configuration, scheduler, destructive library or engine proxy endpoints.
+	allowed := r.Method == "GET" && (r.URL.Path == "/health" || r.URL.Path == "/api/library/list" || r.URL.Path == "/api/prowlarr/search") || r.Method == "POST" && r.URL.Path == "/api/library/add"
+	if !allowed {
+		http.NotFound(w, r)
+		return
+	}
+	if r.ContentLength > 16384 {
+		http.Error(w, "request too large", 413)
+		return
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 16384)
+	http.DefaultServeMux.ServeHTTP(w, r)
+}
