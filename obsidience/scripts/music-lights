#!/usr/bin/env python3
"""Owner controls for the Harness music visualizer; no separate playback owner."""
import argparse
import json
from pathlib import Path
import sys
import urllib.error
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
PROFILE = ROOT / 'obsidience/state/lights-visualizer-calibration.json'
URL = 'http://127.0.0.1:8765/api/lights/visualizer'


def call(path='', payload=None, timeout=25):
    request = urllib.request.Request(URL + path, data=None if payload is None else json.dumps(payload).encode(),
                                     headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        raise RuntimeError(json.loads(error.read()).get('detail', str(error.code))) from None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['on', 'off', 'status', 'sources', 'measure-flashes'])
    parser.add_argument('--stream', type=int, help='Observed stream ID from sources')
    parser.add_argument('--delay-ms', type=float, help='Explicit delay; otherwise use the saved measured profile')
    parser.add_argument('--uncalibrated', action='store_true', help='Allow an explicit unmeasured delay')
    args = parser.parse_args()
    if args.action == 'on':
        profile = json.loads(PROFILE.read_text()) if PROFILE.exists() and not args.uncalibrated else None
        delay = args.delay_ms if args.delay_ms is not None else profile.get('requested_audio_delay_ms') if profile else None
        if delay is None:
            raise RuntimeError('No timing profile: choose --delay-ms and --uncalibrated explicitly')
        payload = {'action': 'start', 'audio_delay_ms': delay}
        if args.uncalibrated:
            payload['uncalibrated'] = True
        if args.stream is not None:
            payload['stream_id'] = args.stream
        result = call(payload=payload)
    elif args.action == 'off':
        result = call(payload={'action': 'stop'})
    elif args.action == 'sources':
        result = call('/sources')
    elif args.action == 'measure-flashes':
        result = call('/calibration', {}, timeout=180)
        # Device identifiers stay in private installation state, not terminal output.
        result = {**result, 'fixtures': {name: {k:v for k,v in row.items() if k != 'mac'}
                                       for name,row in result['fixtures'].items()}}
    else:
        result = call()
    print(json.dumps(result, indent=2))
    if result.get('state') == 'failed' or result.get('cleanup_errors'):
        return 1
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (RuntimeError, OSError, ValueError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
