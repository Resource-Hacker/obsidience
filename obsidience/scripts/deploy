#!/usr/bin/env python3
"""Deploy the committed working tree to the live services, or roll it back.

The live services run from this checkout, so a deploy is: require that what
its restarts load is committed, wait for an idle moment, restart only the
owners whose files changed since the last deployed commit, verify health, and
record the commit. A rollback reverts the commits since the previous deploy
and deploys that.

Several sessions work in this checkout at once. Another session's uncommitted
file stops a deploy only where a restart would load it: in an owner this
deploy restarts. Elsewhere it is named and left alone.

    obsidience/scripts/deploy            # deploy HEAD
    obsidience/scripts/deploy --dry-run  # show what would restart
    obsidience/scripts/deploy --rollback # revert to the previous full deploy
    obsidience/scripts/deploy --only media-catalogue --restart media-catalogue
    obsidience/scripts/deploy --only harness --restart harness --recover-realtime

--only narrows the affected owners; --restart also selects a private-config
owner when its tracked files did not change. Required dependent restarts stay
included. An installed Discord camera active before a Harness/UI deployment is
restored after dependency readiness, including scoped Realtime recovery. Scoped
deploys record a separate receipt and leave the full-deploy
checkpoint and rollback history unchanged; the next full deploy still handles
all pending owners. Scoped rollback is not supported: restore the selected
owner's matching configuration/source backup and deploy that owner explicitly.

--recover-realtime permits a Harness-only repair when Realtime is already in
error. Idle admission and every post-restart readiness check remain required.

Gemma (obsidience/scripts/llm.sh) is never restarted automatically.
"""
import argparse
import json
import os
import pathlib
import shutil
import socket
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parents[2]
STATE = ROOT / "obsidience" / "state"
RECORD, LOG = STATE / "deploy.json", STATE / "deploys.jsonl"
PARTIAL_LOG = STATE / "deploy-partials.jsonl"
API = "http://127.0.0.1:8765"
RESTART_SHELL = ROOT / "obsidience" / "shell" / "session" / "restart-shell"
HARNESS_UNITS = "obsidience/harness/systemd/"
SHELL_UNITS = ROOT / "obsidience" / "shell" / "systemd"
# Unit templates whose installed copies are what runs; an identical move changes none of them.
UNIT_SOURCES = ("obsidience/tv/systemd/", "obsidience/shell/systemd/", "obsidience/discord/systemd/", "obsidience/lights/systemd/", HARNESS_UNITS)


def git(*args: str) -> str:
    return subprocess.run(["git", "-C", str(ROOT), *args], check=True,
                          capture_output=True, text=True).stdout.strip()


def get(path: str) -> dict:
    with urllib.request.urlopen(API + path, timeout=3) as response:
        return json.load(response)


def ledger(sql: str) -> list:
    uri = f"file:{STATE / 'obsidience.sqlite3'}?mode=ro"
    with sqlite3.connect(uri, uri=True) as db:
        return db.execute(sql).fetchall()


def changed_paths(base: str, head: str) -> list[str]:
    paths = []
    for row in git("diff", "-M", "--name-status", f"{base}..{head}").splitlines():
        status, *names = row.split("\t")
        if status == "R100" and names[-1].startswith(UNIT_SOURCES):
            continue
        paths.append(names[-1])
    return paths


def targets(changed: list[str]) -> list[str]:
    owners = []
    # Unit templates are installed copies; a Harness restart does not load them.
    if any(p.startswith("obsidience/harness/") and not p.startswith(HARNESS_UNITS) for p in changed):
        owners.append("harness")
    if any(p.startswith("obsidience/shell/") for p in changed):
        owners.append("shell")
    if any(p.startswith("obsidience/ui/") for p in changed):
        owners.append("ui")
    if any(p.startswith("obsidience/lights/") for p in changed):
        owners.append("lights")
    camera_unit = "obsidience/discord/systemd/obsidience-discord-camera.service"
    if any(p.startswith("obsidience/discord/") and not p.startswith("obsidience/discord/camera/")
           and p != camera_unit for p in changed):
        owners.append("discord")
    if any(p.startswith("obsidience/discord/camera/") or p == camera_unit for p in changed):
        owners.append("discord-camera")
    if "obsidience/tv/systemd/obsidience-tv-player.service" in changed:
        owners.append("tv-player")
    if (any(p in {"obsidience/tv/host/tuner.py", "obsidience/tv/host/break-view", "obsidience/tv/systemd/obsidience-tv-tuner.service",
                  "obsidience/harness/media/config.py", "obsidience/harness/media/sources.py",
                  "obsidience/harness/media/source_probe.py", "obsidience/harness/media/torbox_files.py",
                  "obsidience/harness/media/torbox.py", "obsidience/harness/media/progress.py",
                  "obsidience/harness/media/jellyfin.py"} for p in changed)
            or "tv-player" in owners):
        owners.append("tv-tuner")
    if "obsidience/media/obsidience-media-jellyfin.container" in changed:
        owners.append("media-catalogue")
    for provider in ("prowlarr", "tiramisu"):
        if (f"obsidience/media/obsidience-media-{provider}.service" in changed
                or "obsidience/media/provider-launch" in changed
                or (provider == "tiramisu" and "obsidience/media/tiramisu-owner-sockets.patch" in changed)):
            owners.append("media-" + provider)
    if any(p in {"obsidience/media/torbox-mount", "obsidience/media/obsidience-media-torbox.service"} for p in changed):
        owners.append("media-torbox")
    return owners


def provider_health(provider: str) -> dict:
    if provider == "torbox":
        sys.path.insert(0, str(ROOT / "obsidience"))
        from harness.media.config import load_config
        from harness.media.torbox_files import ready_mount
        config = load_config()
        roots = [r for r in config['roots'] if r.get('provider') == 'torbox']
        if not roots:
            return {"ready": False}
        ready_mount(roots[0])
        return {"ready": True}
    if provider == "tiramisu":
        import httpx
        path = f"/run/user/{os.getuid()}/obsidience-media-tiramisu/control.sock"
        with httpx.Client(transport=httpx.HTTPTransport(uds=path), timeout=3, trust_env=False) as client:
            response = client.get("http://localhost/health")
            response.raise_for_status()
            return response.json()
    with urllib.request.urlopen("http://127.0.0.1:9696/ping", timeout=3) as response:
        return {"ready": response.status == 200}


def require_provider_idle() -> None:
    unit = subprocess.run(["systemctl", "--user", "is-active", "--quiet",
                           "obsidience-media-tiramisu.service"])
    if unit.returncode != 0:
        return
    try:
        state = provider_health("tiramisu")
        if state.get("readers") != 0 or state.get("pumps") != 0 or not state.get("ready"):
            raise ValueError("virtual media has active readers or unavailable state")
    except Exception as error:
        sys.exit(f"Media provider deployment deferred: {error}; nothing restarted.")


def require_catalogue_idle() -> None:
    """A provider restart must not interrupt independently playing Jellyfin clients."""
    if subprocess.run(["systemctl", "--user", "is-active", "--quiet",
                       "obsidience-media-jellyfin.service"]).returncode != 0:
        return
    try:
        config = json.loads((STATE / "media.json").read_text())["catalogue"]
        credential = (pathlib.Path(f"/run/user/{os.getuid()}/credentials/obsidience-harness-dev.service")
                      / config["credential"]).read_text().strip()
        request = urllib.request.Request(config["url"] + "/Sessions", headers={
            "Authorization": 'MediaBrowser Client="Obsidience Media", Device="Deployment", '
                             'DeviceId="obsidience-media-deploy", Version="1", Token="' + credential + '"'})
        with urllib.request.urlopen(request, timeout=3) as response:
            sessions = json.loads(response.read(262145))
        if not isinstance(sessions, list) or any(row.get("NowPlayingItem") for row in sessions):
            raise ValueError("active or unknown catalogue playback")
    except Exception:
        sys.exit("Media deployment deferred: catalogue playback is active or could not be verified idle.")


def tuner_state() -> dict:
    runtime = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(3)
        sock.connect(str(runtime / "obsidience-tv/tuner.sock"))
        sock.sendall(b'{"op":"state"}\n')
        with sock.makefile('rb') as response:
            line = response.readline(65537)
    if len(line) > 65536:
        raise ValueError("Tuner reply exceeds bound")
    reply = json.loads(line)
    if not reply.get("ok") or not isinstance(reply.get("state"), dict):
        raise ValueError("Tuner state unavailable")
    return reply["state"]


def require_tv_idle() -> None:
    """Refuse before restarting any owner if the TV's playback is active or unknown."""
    try:
        state = tuner_state()
        if not state.get("player") or state.get("playback") != "idle":
            raise ValueError("TV player is active or unavailable")
        if subprocess.run(["systemctl", "--user", "is-active", "--quiet", "obsidience-tv-android.service"]).returncode == 0:
            sys.path.insert(0, str(ROOT))
            from obsidience.harness.tv.android import state as android_state
            android = android_state()
            if android is None or android.get("playback") != "idle":
                raise ValueError("TV Android playback is active or unavailable")
    except (OSError, ValueError) as error:
        sys.exit(f"TV deployment deferred: {error}; nothing restarted. Stop playback at an owner-selected boundary.")


def install_tv_unit(name: str) -> None:
    destination = pathlib.Path.home() / ".config/systemd/user" / name
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(ROOT / "obsidience/tv/systemd" / name, destination)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)


def install_shell_units() -> None:
    """Make the installed Shell units match the tree the restart loads.

    The host seeds its state from repository paths in ExecStartPre, so a stale
    copy stops the Shell from starting after those paths move or are rolled back.
    """
    installed = pathlib.Path.home() / ".config/systemd/user"
    stale = [source for source in sorted(SHELL_UNITS.iterdir())
             if source.is_file() and (installed / source.name).is_file()
             and (installed / source.name).read_bytes() != source.read_bytes()]
    for source in stale:
        shutil.copy2(source, installed / source.name)
    if stale:
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        print("Installed Shell units:", ", ".join(source.name for source in stale))


def wait_idle(limit: float = 900) -> None:
    deadline = time.monotonic() + limit
    while time.monotonic() < deadline:
        try:
            realtime = get("/api/realtime")
            busy = (realtime.get("playback", {}).get("status") not in (None, "idle")
                    or realtime.get("phase") in {"thinking", "speaking"})
            tasks = get("/api/tasks")
            # A Task in review has finished and waits only for the owner.
            busy = busy or any(task.get("execution", {}).get("state") not in
                               {"idle", "blocked", "failed", "needs_attention", "review"} for task in tasks)
            try:
                discord = get("/api/discord/status")
            except urllib.error.HTTPError as error:
                if error.code != 404:
                    raise
                discord = {}  # First deployment from a pre-Discord Harness.
            transport = discord.get("transport") or {}
            busy = busy or bool(discord.get("active_turns") or transport.get("active_turns")
                                or transport.get("pending_speech"))
            busy = busy or any(transport.get(key) not in (None, "idle")
                               for key in ("playback", "speech_playback"))
            # The conversation's live owner, not historical run rows, decides
            # whether a turn is active. This subscription sends no command.
            from websockets.sync.client import connect
            with connect("ws://127.0.0.1:8765/ws/chat", open_timeout=3,
                         close_timeout=1, max_size=4 * 1024 * 1024) as ws:
                for _ in range(8):
                    message = json.loads(ws.recv(timeout=3))
                    if message.get("type") == "active_turn":
                        busy = busy or bool(message.get("turn_id"))
                        break
                else:
                    raise ValueError("Conversation active-turn state unavailable")
        except Exception as error:
            unit = subprocess.run(["systemctl", "--user", "show", "obsidience-harness-dev.service",
                                   "-p", "ActiveState", "-p", "MainPID"],
                                  capture_output=True, text=True, timeout=3)
            fields = dict(line.split("=", 1) for line in unit.stdout.splitlines() if "=" in line)
            if (unit.returncode == 0 and fields.get("MainPID") == "0"
                    and fields.get("ActiveState") in {"inactive", "failed"}):
                return  # A confirmed stopped owner has no live turn to interrupt.
            sys.exit(f"Cannot establish an idle Harness: {type(error).__name__}; nothing restarted.")
        if not busy:
            return
        time.sleep(3)
    sys.exit("No idle moment within the wait limit; nothing restarted.")


def wait_ready(limit: float = 300) -> None:
    deadline = time.monotonic() + limit
    while time.monotonic() < deadline:
        try:
            # FastAPI serves requests only after its startup lifespan completes.
            # Desktop speech health is checked separately by check_voice().
            if get("/api/status").get("name") == "obsidience":
                return
        except OSError:
            pass
        time.sleep(2)
    sys.exit("The Harness API did not initialize; inspect journalctl --user -u obsidience-harness-dev.")


def wait_camera_data(limit: float = 30) -> None:
    """Require the camera's public graph dependency before restoring its owner."""
    deadline = time.monotonic() + limit
    while time.monotonic() < deadline:
        try:
            if get("/api/discord/presentation").get("available") is True:
                return
        except OSError:
            pass
        time.sleep(.5)
    sys.exit("Discord graph data did not become available; camera not restored.")


def check_voice(limit: float = 90) -> str | None:
    """After a Harness restart, voice must come back in the owner's requested mode."""
    try:
        requested = json.loads(pathlib.Path("/run/user/1000/obsidience-realtime/requested.json").read_text())
    except (OSError, ValueError):
        return None
    mode = requested.get("mode", "wake") if isinstance(requested, dict) else "wake"
    if mode == "off":
        return None
    deadline = time.monotonic() + limit
    state = {}
    while time.monotonic() < deadline:
        try:
            state = get("/api/realtime")
            if state.get("mode") == mode and state.get("ready") and state.get("phase") != "error":
                return None
        except OSError:
            pass
        time.sleep(3)
    return f"voice did not return to {mode}: phase={state.get('phase')} last_error={state.get('last_error')}"


def restart(owner: str) -> None:
    if owner == "lights":
        name = "obsidience-lights.service"
        destination = pathlib.Path.home() / ".config/systemd/user" / name
        if not destination.exists():
            print("Matter lights are not installed; installation remains explicit.")
            return
        if get("/api/lights/visualizer").get("state") in {"starting", "running", "restoring"}:
            sys.exit("Stop and drain light effects before restarting the Matter owner.")
        subprocess.run(["npm", "ci", "--omit=dev", "--ignore-scripts", "--no-audit", "--no-fund"],
                       cwd=ROOT / "obsidience/lights", check=True)
        shutil.copy2(ROOT / "obsidience/lights/systemd" / name, destination)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "restart", name], check=True)
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            try:
                with socket.socket(socket.AF_UNIX) as peer:
                    peer.settimeout(2)
                    peer.connect(f"/run/user/{os.getuid()}/obsidience-lights/control.sock")
                    peer.sendall(b'{"command":"status"}\n')
                    with peer.makefile() as response:
                        state = json.loads(response.readline(16384))
                    if state.get("ok") is True and state.get("result", {}).get("protocol") == "matter":
                        return
            except (OSError, ValueError):
                pass
            time.sleep(.5)
        sys.exit("Matter controller did not become ready; inspect obsidience-lights.service.")
    elif owner == "discord-camera":
        name = "obsidience-discord-camera.service"
        destination = pathlib.Path.home() / ".config/systemd/user" / name
        if not destination.exists():
            print("Discord camera is not installed; installation remains explicit.")
            return
        shutil.copy2(ROOT / "obsidience/discord/systemd" / name, destination)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "restart", name], check=True)
    elif owner == "discord":
        name = "obsidience-discord-bot.service"
        destination = pathlib.Path.home() / ".config/systemd/user" / name
        if not destination.exists():
            print("Discord is not installed; installation remains explicit.")
            return
        subprocess.run(["npm", "ci", "--omit=dev", "--no-audit", "--no-fund"],
                       cwd=ROOT / "obsidience/discord", check=True)
        shutil.copy2(ROOT / "obsidience/discord/systemd" / name, destination)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "restart", name], check=True)
        deadline = time.monotonic() + 45
        while time.monotonic() < deadline:
            try:
                state = get("/api/discord/status")
                if (state.get("transport") or {}).get("ready") is True:
                    return
            except OSError:
                pass
            time.sleep(1)
        sys.exit("Discord did not become ready; inspect obsidience-discord-bot.service.")
    elif owner in {"media-tiramisu", "media-prowlarr", "media-torbox"}:
        provider = owner.removeprefix("media-")
        name = f"obsidience-media-{provider}.service"
        source = ROOT / "obsidience/media" / name
        destination = pathlib.Path.home() / ".config/systemd/user" / name
        if not destination.exists():
            print(f"{provider} is not installed; provider installation remains explicit.")
            return
        if provider in {"tiramisu", "torbox"}:
            require_catalogue_idle()
            if provider == "tiramisu":
                require_provider_idle()
            else:
                require_tv_idle()
        shutil.copy2(source, destination)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        old_pid = subprocess.check_output(["systemctl", "--user", "show", name,
                                           "-p", "MainPID", "--value"], text=True).strip()
        subprocess.run(["systemctl", "--user", "restart", "--no-block", name], check=True)
        deadline = time.monotonic() + 40
        while time.monotonic() < deadline:
            try:
                new_pid = subprocess.check_output(["systemctl", "--user", "show", name,
                                                   "-p", "MainPID", "--value"], text=True).strip()
                if new_pid not in {"0", old_pid} and provider_health(provider).get("ready") is True:
                    return
            except Exception:
                pass
            time.sleep(.5)
        sys.exit(f"{provider} has not become ready; inspect its owner, never force an active unmount.")
    elif owner == "harness":
        subprocess.run(["systemctl", "--user", "restart", "obsidience-harness-dev.service"], check=True)
        wait_ready()
    elif owner == "shell":
        install_shell_units()
        subprocess.run([str(RESTART_SHELL)], check=True)
    elif owner == "ui":
        subprocess.run(["npm", "--prefix", str(ROOT / "obsidience" / "ui"), "run", "build"], check=True)
        subprocess.run(["systemctl", "--user", "restart", "obsidience-shell-knowledge.service"], check=True)
    elif owner in {"tv-player", "tv-tuner"}:
        require_tv_idle()
        unit = "obsidience-" + owner + ".service"
        install_tv_unit(unit)
        if owner == "tv-player":
            install_tv_unit("obsidience-tv-tuner.service")
        subprocess.run(["systemctl", "--user", "restart", unit], check=True)
        # Restarting the required player stops the tuner; restore that same owner.
        subprocess.run(["systemctl", "--user", "start", "obsidience-tv-tuner.service"], check=True)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            try:
                state = tuner_state()
                if state.get("player") and state.get("playback") == "idle":
                    return
            except (OSError, ValueError):
                pass
            time.sleep(.2)
        sys.exit("TV owner did not return idle and ready; inspect its journal.")
    elif owner == "media-catalogue":
        require_catalogue_idle()
        unit = "obsidience-media-jellyfin.container"
        source = ROOT / "obsidience/media" / unit
        destination = pathlib.Path.home() / ".config/containers/systemd" / unit
        if not destination.exists():
            print("Media catalogue is not installed; provider installation remains explicit.")
            return
        if not source.is_file():
            print("Media unit removed from code; retaining the independently installed provider and data. "
                  "Provider rollback requires its matching configuration/data backup.")
            return
        shutil.copy2(source, destination)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "restart", "obsidience-media-jellyfin.service"], check=True)
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            try:
                with urllib.request.urlopen("http://127.0.0.1:8096/health", timeout=3) as response:
                    if response.status == 200:
                        return
            except OSError:
                pass
            time.sleep(.5)
        sys.exit("Media catalogue did not become healthy")


def failures_since(started: float) -> list[str]:
    rows = ledger("SELECT entry FROM trace_events ORDER BY seq DESC LIMIT 200")
    found = []
    for (entry,) in rows:
        try:
            item = json.loads(entry)
        except (TypeError, ValueError):
            continue
        stamp = item.get("at", 0) / 1000
        line = str(item.get("line", ""))
        if stamp >= started and (item.get("channel") == "error" or "turn failed" in line):
            found.append(f"{item.get('channel')}: {line} {item.get('detail', '')}"[:240])
    return found


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--rollback", action="store_true")
    parser.add_argument("--restart", action="append", default=[],
                        choices=("harness", "lights", "discord", "discord-camera", "tv-player", "tv-tuner", "media-catalogue", "media-tiramisu", "media-prowlarr", "media-torbox"),
                        help="Include an affected owner after a private configuration change")
    parser.add_argument("--only", action="append", default=[],
                        choices=("harness", "shell", "ui", "lights", "discord", "discord-camera", "tv-player", "tv-tuner",
                                 "media-catalogue", "media-tiramisu", "media-prowlarr", "media-torbox"),
                        help="Deploy only selected affected owners; keep the full checkpoint unchanged")
    parser.add_argument("--recover-realtime", action="store_true",
                        help="Repair an existing Realtime error with a Harness-only deployment")
    args = parser.parse_args()
    if args.only and args.rollback:
        parser.error("--only cannot be combined with --rollback; scoped receipts are not full deploys")
    if args.only and set(args.restart) - set(args.only):
        parser.error("each --restart owner must also be selected with --only")
    dirty = sorted(set(git("diff", "--name-only", "HEAD").splitlines()
                       + git("ls-files", "--others", "--exclude-standard").splitlines()))
    last = json.loads(RECORD.read_text()).get("commit") if RECORD.is_file() else None
    previous = None
    if args.rollback:
        if dirty:
            sys.exit("Tracked changes are uncommitted; commit them before rolling back.")
        history = [json.loads(line) for line in LOG.read_text().splitlines()] if LOG.is_file() else []
        if len(history) < 2:
            sys.exit("No previous deploy is recorded.")
        previous = history[-2]["commit"]
        print("would revert", git("log", "--oneline", f"{previous}..HEAD"))
    head = git("rev-parse", "HEAD")
    base = previous if args.rollback else last
    changed = changed_paths(base, head) if base else ["obsidience/harness/", "obsidience/shell/", "obsidience/ui/"]
    owners = targets(changed)
    owners = list(dict.fromkeys([*owners, *args.restart]))
    if args.only:
        owners = [owner for owner in owners if owner in args.only]
    if args.recover_realtime and set(owners) != {"harness"}:
        parser.error("--recover-realtime requires a Harness-only deployment")
    # Validate the requested recovery scope above before adding its dependent.
    # Preserve intentionally stopped/failed cameras; never install one implicitly.
    camera_unit = pathlib.Path.home() / ".config/systemd/user/obsidience-discord-camera.service"
    if ({"harness", "ui"} & set(owners) and "discord-camera" not in owners
            and camera_unit.is_file()
            and subprocess.run(["systemctl", "--user", "is-active", "--quiet",
                                "obsidience-discord-camera.service"]).returncode == 0):
        owners.append("discord-camera")
        print("Dependency restoration: the active Discord camera will restart after "
              "Harness/UI readiness; the requested --only scope stays unchanged.")
    camera_after_dependencies = ("discord-camera" in owners
                                 and bool({"harness", "ui"} & set(owners)))
    if "tv-player" in owners and "tv-tuner" not in owners:
        owners.append("tv-tuner")
    for owner in tuple(owners):
        if owner not in {"tv-player", "tv-tuner"}:
            continue
        unit = subprocess.run(["systemctl", "--user", "show", f"obsidience-{owner}.service",
                               "-p", "LoadState", "--value"],
                              capture_output=True, text=True, check=True)
        if unit.stdout.strip() == "not-found":
            owners.remove(owner)
            print(f"{owner} is not installed; the optional TV destination is not started by media deployment.")
    unfinished = [path for path in dirty if set(targets([path])) & set(owners)]
    if unfinished:
        sys.exit("This deploy restarts " + ", ".join(owners) + ", which would load uncommitted changes; "
                 "commit them first: " + ", ".join(unfinished))
    if dirty:
        print("Note: uncommitted and not part of this deploy:", ", ".join(dirty))
    if "obsidience/scripts/llm.sh" in changed:
        print("Note: llm.sh changed; restart obsidience-gemma.service deliberately (not automatic).")
    if units := [p for p in changed if p.startswith(HARNESS_UNITS)]:
        print("Note: Harness unit templates changed; install them into ~/.config/systemd/user "
              "and daemon-reload deliberately (not automatic):", ", ".join(units))
    kind = "scoped deploy" if args.only else "deploy"
    print(f"{kind} {last and last[:7]} -> {head[:7]}; restart: {', '.join(owners) or 'nothing'}")
    if args.dry_run:
        return
    started = time.time()
    if owners:
        if "harness" in owners:
            # Do not restart first and then discover that an existing dependency
            # fault makes the normal readiness gate impossible to satisfy.
            try:
                baseline = get("/api/realtime")
            except OSError:
                baseline = {}  # A down Harness can still be recovered normally.
            baseline_error = baseline.get("phase") == "error" and baseline.get("ready") is not True
            if args.recover_realtime and not baseline_error:
                sys.exit("Realtime recovery requires an observed existing Realtime error; nothing restarted.")
            if baseline_error and not args.recover_realtime:
                sys.exit("Deployment deferred before any restart: Realtime is already in error; "
                         "resolve its existing dependency fault or deploy its Harness repair with "
                         "--only harness --restart harness --recover-realtime.")
            if args.recover_realtime:
                print("Recovering the existing Realtime error; normal readiness checks remain required.")
        wait_idle()
        if any(owner in owners for owner in ("tv-player", "tv-tuner")):
            require_tv_idle()
        if "media-tiramisu" in owners:
            require_catalogue_idle()
            require_provider_idle()
        elif "media-catalogue" in owners or "media-torbox" in owners:
            require_catalogue_idle()
        if "media-torbox" in owners:
            require_tv_idle()
    if args.rollback:
        # Check the live owners before changing even the source checkout.
        git("revert", "--no-edit", f"{previous}..HEAD")
        head = git("rev-parse", "HEAD")
    if owners:
        for owner in owners:
            if owner == "discord-camera" and camera_after_dependencies:
                continue  # Restore once, after the Harness/UI dependency restarts.
            if owner == "tv-tuner" and "tv-player" in owners:
                continue  # The player restart already restored the tuner with its current unit.
            restart(owner)
        if camera_after_dependencies:
            # The public graph depends on Harness/UI, not desktop audio hardware.
            # A failed restart or unavailable graph still prevents restoration.
            wait_camera_data()
            restart("discord-camera")
        time.sleep(5)
    failures = failures_since(started)
    if "harness" in owners and (voice := check_voice()):
        failures.append(voice)
    for line in failures:
        print("trace failure:", line)
    if args.only:
        entry = {"scope": "partial", "commit": head, "full_checkpoint": last,
                 "at": started, "selected": list(dict.fromkeys(args.only)),
                 "owners": owners, "failures": len(failures)}
        with PARTIAL_LOG.open("a") as log:
            log.write(json.dumps(entry) + "\n")
        print("scoped deployment recorded; full checkpoint unchanged" if not failures else
              "scoped deployment recorded with trace failures; inspect selected owners; full checkpoint unchanged")
        return
    entry = {"commit": head, "previous": last, "at": started, "owners": owners, "failures": len(failures)}
    RECORD.write_text(json.dumps(entry) + "\n")
    with LOG.open("a") as log:
        log.write(json.dumps(entry) + "\n")
    print("deployed" if not failures else "deployed with trace failures; consider --rollback")


if __name__ == "__main__":
    main()
