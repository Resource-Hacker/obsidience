#!/usr/bin/env python3
"""Build the attested embedded Harness2 package and install both optimizer dependencies.

Run from any directory. --build-only leaves the selected Python environment untouched.
AutoSaddler supplies durable candidates/trials and remains an explicit rollback backend.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tarfile
import tempfile
import urllib.request
import zipfile

ROOT = Path(__file__).resolve().parents[2]
REVISION = "1cfe254e8d25b15f37048c3730134686abe60335"
ARCHIVE_SHA256 = "2337f91b71a130e055d8dfb99ead2667a46087c29df939d4d4f0a3c357b5748f"
VERSION = "0.1.0+obsidience.1"
BUILD_SHA256 = "f1e859bf8fa018b866d0bea8c2664e82839986a702e1905d2eae3e3a37e32e02"
SOURCE_DATE_EPOCH = "1791944569"
PATCH = ROOT / "obsidience/scripts/patches/harness2/0001-embedded-python314.patch"


def digest(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--python", type=Path, default=ROOT / ".venv/bin/python")
    parser.add_argument("--archive", type=Path)
    parser.add_argument("--build-only", action="store_true")
    args = parser.parse_args()
    python = args.python.absolute()
    if not python.is_file() or not shutil.which("uv"):
        parser.error("An existing Python environment and uv are required")
    if args.archive:
        raw = args.archive.read_bytes()
    else:
        url = f"https://codeload.github.com/google-research/harness2/tar.gz/{REVISION}"
        with urllib.request.urlopen(url, timeout=60) as response:
            raw = response.read(40_000_001)
    if len(raw) > 40_000_000 or digest(raw) != ARCHIVE_SHA256:
        raise ValueError("Harness2 source archive does not match its pinned SHA256")
    destination = ROOT / ".artifacts/wheels"
    destination.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="obsidience-harness2-") as temporary:
        stage = Path(temporary)
        archive = stage / "source.tar.gz"
        archive.write_bytes(raw)
        with tarfile.open(archive) as bundle:
            members = bundle.getmembers()
            prefix = f"harness2-{REVISION}"
            if any(member.name.split("/")[0] != prefix or
                   not (member.isfile() or member.isdir()) for member in members):
                raise ValueError("Harness2 archive contains unexpected entries")
            bundle.extractall(stage, filter="data")
        source = stage / prefix
        subprocess.run(["git", "apply", "--check", str(PATCH)], cwd=source, check=True)
        subprocess.run(["git", "apply", str(PATCH)], cwd=source, check=True)
        package = source / "harness2"
        manifest = {
            "upstream_revision": REVISION,
            "version": VERSION,
            "source_archive_sha256": ARCHIVE_SHA256,
            "patches": {PATCH.name: digest(PATCH.read_bytes())},
            "files": {str(path.relative_to(package)): digest(path.read_bytes())
                      for path in sorted(package.rglob("*.py"))},
        }
        manifest_bytes = (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode()
        if digest(manifest_bytes) != BUILD_SHA256:
            raise ValueError("Patched Harness2 source differs from the admitted build manifest")
        (package / "obsidience-build.json").write_bytes(manifest_bytes)
        subprocess.run(["uv", "build", "--wheel", "--python", str(python),
                        "--out-dir", str(stage / "wheels"), str(source)], check=True,
                       env={**os.environ, "SOURCE_DATE_EPOCH": SOURCE_DATE_EPOCH})
        wheels = list((stage / "wheels").glob("*.whl"))
        if len(wheels) != 1:
            raise ValueError("Expected exactly one Harness2 wheel")
        wheel = wheels[0]
        with zipfile.ZipFile(wheel) as packed:
            if json.loads(packed.read("harness2/obsidience-build.json")) != manifest:
                raise ValueError("Built wheel omitted or changed package provenance")
            for relative, expected in manifest["files"].items():
                if digest(packed.read("harness2/" + relative)) != expected:
                    raise ValueError(f"Built wheel changed Harness2 source: {relative}")
        target = destination / wheel.name
        shutil.copyfile(wheel, target)
        print(json.dumps({"wheel": str(target.relative_to(ROOT)),
                          "sha256": digest(target.read_bytes()),
                          "manifest_sha256": digest((
                              json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode()),
                          "upstream_revision": REVISION}, sort_keys=True))
    if not args.build_only:
        subprocess.run(["uv", "pip", "install", "--python", str(python), "--no-deps",
                        "-r", "obsidience/harness/requirements-optimization.txt"],
                       cwd=ROOT, check=True)


if __name__ == "__main__":
    main()
