+        # reference offset, so the window is that local day rather than the same date in UTC.
+        if parsed_date.tzinfo is None and reference_date.tzinfo is not None:
+            parsed_date = parsed_date.replace(tzinfo=reference_date.tzinfo)
+
         # Create constraint for single day
