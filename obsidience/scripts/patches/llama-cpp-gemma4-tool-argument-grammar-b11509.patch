+    {"char", "g4-char"}, {"uuid", "g4-uuid"}, {"date-string", "g4-date-string"},
+    {"time-string", "g4-time-string"}, {"date-time-string", "g4-date-time-string"},
+    {"key", "g4-key"}, {"key-char", "g4-key-char"},
+};
+
+// A constant in Gemma 4 argument syntax.
+static std::string gemma4_dump(const json & value) {
+    if (value.is_string()) {
+        return "<|\"|>" + value.get<std::string>() + "<|\"|>";
+    }
+    std::vector<std::string> parts;
+    if (value.is_object()) {
+        for (const auto & item : value.items()) {
+            parts.push_back(item.key() + ":" + gemma4_dump(item.value()));
+        }
+        return "{" + string_join(parts, ",") + "}";
+    }
+    if (value.is_array()) {
+        for (const auto & item : value) {
+            parts.push_back(gemma4_dump(item));
+        }
+        return "[" + string_join(parts, ",") + "]";
+    }
+    return value.dump();
+}
