+    {"g4-object", {R"("{" space ( g4-key ":" space g4-value ("," space g4-key ":" space g4-value)* )? space "}")", {"g4-key", "g4-value"}}},
+    {"g4-array", {R"("[" space ( g4-value ("," space g4-value)* )? space "]")", {"g4-value"}}},
