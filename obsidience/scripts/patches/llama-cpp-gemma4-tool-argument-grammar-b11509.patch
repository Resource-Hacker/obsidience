+    {"g4-string-1", {R"(( [^<|] g4-string-0 | "<" g4-string-1 | "|" g4-string-2 )?)", {}}},
+    {"g4-string-2", {R"(( [^<"] g4-string-0 | "<" g4-string-1 | "\"" g4-string-3 )?)", {}}},
+    {"g4-string-3", {R"(( [^<|] g4-string-0 | "<" g4-string-1 | "|" g4-string-4 )?)", {}}},
+    {"g4-string-4", {R"(( [^<>] g4-string-0 | "<" g4-string-1 )?)", {}}},
