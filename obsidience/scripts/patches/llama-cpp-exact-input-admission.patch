--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -4072,12 +4072,45 @@
         // process prompt
         std::vector<server_tokens> inputs;
 
+        // Optional application-owned input ceiling; never increase the slot capacity.
+        int64_t input_token_limit = 0;
+        if (data.contains("input_token_limit")) {
+            const auto & value = data.at("input_token_limit");
+            if (!value.is_number_integer()) {
+                throw std::invalid_argument("input_token_limit must be a positive integer");
+            }
+            input_token_limit = value.get<int64_t>();
+            if (input_token_limit <= 0 || input_token_limit > meta->slot_n_ctx) {
+                throw std::invalid_argument("input_token_limit must be within the slot context capacity");
+            }
+        }
+
         if (res_type != TASK_RESPONSE_TYPE_NONE && ctx_server.mctx != nullptr) {
             // This is the case used by OAI compatible chat path with MTMD. TODO It can be moved to the path below.
             inputs.push_back(process_mtmd_prompt(ctx_server.mctx, prompt.get<std::string>(), files));
         } else {
             // Everything else, including multimodal completions.
             inputs = tokenize_input_prompts(ctx_server.vocab, ctx_server.mctx, prompt, true, true);
+        }
+
+        if (input_token_limit > 0) {
+            if (inputs.size() != 1) {
+                throw std::invalid_argument("input_token_limit requires exactly one input prompt");
+            }
+            const int64_t input_tokens = inputs[0].size();
+            if (input_tokens > input_token_limit) {
+                auto error = format_error_response("input prompt exceeds input_token_limit",
+                                                   ERROR_TYPE_EXCEED_CONTEXT_SIZE);
+                error["reason"] = "input_token_limit_exceeded";
+                error["pre_enqueue"] = true;
+                error["input_tokens"] = input_tokens;
+                error["input_token_limit"] = input_token_limit;
+                res->error(error);
+                return res;
+            }
+            // Positive acknowledgement of this exact request's enforced ceiling.
+            res->headers["X-LLAMA-Input-Tokens"] = std::to_string(input_tokens);
+            res->headers["X-LLAMA-Input-Token-Limit"] = std::to_string(input_token_limit);
         }
 
