#!/usr/bin/env bash
# Power-cycle the miniDSP UMA-8 (2752:001c) through an approved hub power switch.
# Never reset a non-switching port after a software capture stall.
#
# Capture delivery can stop without a USB fault. A root-port USB reset then
# disconnected the UMA-8 indefinitely on 2026-10-28 and 2026-11-04; it does not
# remove power. Only the allow-listed, individually switching dock hub ports
# below can perform this recovery. Leave all other endpoints connected so the
# audio layer can inspect/reopen them without a destructive USB reset.
# Installed root-owned as /usr/local/libexec/obsidience-uma8-power-cycle.
set -euo pipefail

exec 9>/run/obsidience-uma8-power-cycle.lock
flock -n 9 || { echo 'UMA-8 power cycle is already running' >&2; exit 75; }

dev=
for candidate in /sys/bus/usb/devices/*; do
    if [[ -f $candidate/idVendor && $(<"$candidate/idVendor") == 2752 && $(<"$candidate/idProduct") == 001c ]]; then
        dev=$candidate
        break
    fi
done
[[ -n $dev ]] || { echo 'UMA-8 is not connected' >&2; exit 69; }

name=${dev##*/}
devnum=$(<"$dev/devnum")

# A power cycle ends when the UMA-8 is back on the same port as a new device.
await_return() {
    for _ in $(seq 1 30); do
        sleep 0.5
        if [[ -f /sys/bus/usb/devices/$name/idVendor && $(<"/sys/bus/usb/devices/$name/idVendor") == 2752 &&
              $(<"/sys/bus/usb/devices/$name/devnum") != "$devnum" ]]; then
            echo "UMA-8 $1 on $name"
            exit 0
        fi
    done
    echo "UMA-8 did not return on $name after its $2" >&2
    exit 70
}

control=
if [[ $name == *.* ]]; then
    hub=${name%.*}
    port=${name##*.}
    hubdir=/sys/bus/usb/devices/$hub
    case "$(<"$hubdir/idVendor"):$(<"$hubdir/idProduct")" in
        2109:2822|0bda:5411) control=$hubdir/$hub:1.0/$hub-port$port/disable ;;
    esac
fi

if [[ -n $control && -w $control ]]; then
    echo 1 >"$control"
    sleep 2
    echo 0 >"$control"
    await_return power-cycled 'power cycle'
fi

echo "UMA-8 $name is on a port without an approved power switch; leaving USB connected" >&2
exit 69
