#!/bin/bash
# Obsidience TV flash check: record the television's own screen and count frames that are
# suddenly dark between two bright ones (a half-drawn or black frame in the stream).
#   flashcheck ADB_SERIAL [SECONDS]      e.g. flashcheck 192.168.1.45:5555 120
# The recording is what the panel shows (about 10 frames a second, so one-frame flashes are
# sampled, not all caught). Run it over a bright programme: a dark picture hides dark frames.
set -euo pipefail
serial=$1 seconds=${2:-120}
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
adb -s "$serial" shell "screenrecord --time-limit $seconds --size 1280x720 --bit-rate 8000000 /sdcard/obsidience-flashcheck.mp4" >/dev/null
adb -s "$serial" pull /sdcard/obsidience-flashcheck.mp4 "$work/rec.mp4" >/dev/null 2>&1
adb -s "$serial" shell rm -f /sdcard/obsidience-flashcheck.mp4
ffmpeg -v error -i "$work/rec.mp4" -vf "scale=160:90,signalstats,metadata=print:key=lavfi.signalstats.YAVG:file=-" -f null - 2>/dev/null |
python3 -c '
import re, sys
rows, at = [], None
for line in sys.stdin:
    if found := re.search(r"pts_time:([\d.]+)", line):
        at = float(found[1])
    if found := re.search(r"YAVG=([\d.]+)", line):
        rows.append((at, float(found[1])))
if len(rows) < 3:
    sys.exit("The recording holds no frames")
luma = sorted(y for _, y in rows)
dips = [(round(rows[i][0], 2), round(rows[i][1])) for i in range(1, len(rows) - 1)
        if rows[i][1] < 0.5 * min(rows[i - 1][1], rows[i + 1][1])]
print(f"{len(rows)} frames over {rows[-1][0]:.0f} s, median brightness {luma[len(luma) // 2]:.0f}/255, "
      f"dark frames {sum(y < 30 for y in luma)}, sudden dark frames {len(dips)} {dips[:10]}")
sys.exit(1 if dips else 0)'
