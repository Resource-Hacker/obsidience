[Unit]
Description=Obsidience TV stream (Sunshine, captures only the TV session)
Requires=obsidience-tv-session.service obsidience-tv-audio-pulse.service
After=obsidience-tv-session.service obsidience-tv-audio-pulse.service obsidience-tv-player.service
PartOf=obsidience-tv-session.service

[Service]
Type=exec
UnsetEnvironment=DISPLAY HYPRLAND_INSTANCE_SIGNATURE
# The encoder and its GPU come from the TV mode (modes/*.env) and override sunshine.conf.
# NVENC, when used, is on the RTX 4080 only (GPU UUID), never the model GPU.
Environment=CUDA_VISIBLE_DEVICES=GPU-4332e1a5-17a8-7e18-5347-5a296549ee81
# The TV's private audio server: Sunshine's default-sink switching stays in there.
Environment=PULSE_SERVER=unix:%t/obsidience-tv/pulse/native
Environment=PIPEWIRE_RUNTIME_DIR=%t/obsidience-tv
EnvironmentFile=/home/wissenschafter/Projects/obsidience/obsidience/tv/host/modes/default.env
EnvironmentFile=-%t/obsidience-tv/mode.env
ExecStartPre=/bin/sh -c 'for i in $(seq 100); do [ -s %t/obsidience-tv/wayland ] && exit 0; sleep 0.1; done; exit 1'
# Frame pacing: tvpace (tvpace.c beside this file) holds each video frame until its slot on an
# even 60 fps grid. Built here when missing or older than its source. The dynamic loader starts
# Sunshine because glibc ignores LD_PRELOAD for a program with file capabilities.
ExecStartPre=/bin/sh -c '[ %h/.local/lib/obsidience-tv/libtvpace.so -nt /home/wissenschafter/Projects/obsidience/obsidience/tv/host/tvpace.c ] || { mkdir -p %h/.local/lib/obsidience-tv && gcc -O2 -fPIC -shared -o %h/.local/lib/obsidience-tv/libtvpace.so /home/wissenschafter/Projects/obsidience/obsidience/tv/host/tvpace.c; }'
ExecStart=/bin/sh -c 'WAYLAND_DISPLAY=$(cat %t/obsidience-tv/wayland) exec /usr/lib/ld-linux-x86-64.so.2 --preload %h/.local/lib/obsidience-tv/libtvpace.so /usr/bin/sunshine /home/wissenschafter/Projects/obsidience/obsidience/tv/host/sunshine.conf encoder=${TV_ENCODER} adapter_name=${TV_RENDER_NODE}'
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
