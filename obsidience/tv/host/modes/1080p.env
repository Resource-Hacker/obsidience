# Obsidience TV, mode 1080p: the integrated GPU (PCI 7a:00.0) renders and encodes the TV
# session, away from the RTX 4080 that carries the desktop and games (owner, 2026-10-12: the TV
# drops to the integrated GPU during gaming). That GPU encodes 1080p with room to spare and
# cannot keep 60 frames a second at 3840x2160 (measured: 135 against 44 frames a second with
# the side-panel screen recorders running).
TV_MODE=1080p
TV_RENDER_NODE=/dev/dri/by-path/pci-0000:7a:00.0-render
TV_SWAY_CONFIG=/home/wissenschafter/Projects/obsidience/obsidience/tv/host/sway-1080p.conf
TV_VULKAN_DEVICE=00000000-7a00-0000-0000-000000000000
TV_VIDEO_SYNC=display-resample
TV_ENCODER=vaapi
TV_CLIENT_RESOLUTION=1080p
# The break view's capture at the stream's size: a full-size capture and this stream together
# were more than this GPU's encoder could carry (the stream fell to 42 frames a second).
TV_BREAK_CAPTURE=1920x1200
TV_RENDERER=gles2
TV_CLIENT_FPS=60 FPS
