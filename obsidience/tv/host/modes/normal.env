# Obsidience TV, normal mode: the RTX 4080 (PCI 01:00.0) renders the TV session and its NVENC
# encodes a 3840x2160 stream. The TV units read this file, then the active mode's file when
# one is selected (tv/host/mode).
TV_MODE=normal
TV_RENDER_NODE=/dev/dri/by-path/pci-0000:01:00.0-render
TV_SWAY_CONFIG=/home/wissenschafter/Projects/obsidience/obsidience/tv/host/sway.conf
# mpv's Vulkan device (UUID), the GPU of the TV compositor.
TV_VULKAN_DEVICE=4332e1a5-17a8-7e18-5347-5a296549ee81
# Frame timing chosen by measurement on the TV's panel, per compositor GPU (2026-10-12): on the
# RTX 4080 the compositor's frame feedback is irregular while Sunshine captures, so display-synced
# timing skipped refreshes and audio-clock timing skipped none. On the iGPU it was the other way round.
TV_VIDEO_SYNC=audio
TV_ENCODER=nvenc
# The entry of Moonlight's "Video resolution" setting that fits this mode's stream.
TV_CLIENT_RESOLUTION=4K
# The break view's capture of the graph screen: 0x0 keeps that screen's own size.
TV_BREAK_CAPTURE=0x0
